generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  ANALYST
}

enum AppStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LicenseStatus {
  UNUSED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum EndUserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
}

enum VariableVisibility {
  PUBLIC
  AUTHENTICATED
  SERVER
}

enum AccessRuleEffect {
  ALLOW
  DENY
}

enum AccessRuleSubject {
  IP
  INSTALLATION
  USERNAME
  LICENSE
}

enum ChallengeKind {
  PASSKEY_REGISTRATION
  PASSKEY_AUTHENTICATION
}

enum NotificationChannelKind {
  DISCORD
  TELEGRAM
  GENERIC
}

enum AdminEmailOtpPurpose {
  LOGIN
  ENABLE_MFA
}

model AdminUser {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  name               String
  passwordHash       String
  totpSecret         String?
  totpEnabled        Boolean                  @default(false)
  emailOtpEnabled    Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  lastLoginAt        DateTime?
  sessions           AdminSession[]
  emailOtpChallenges AdminEmailOtpChallenge[]
  memberships        Membership[]
  auditEvents        AuditEvent[]             @relation("ActorAuditEvents")
  invitedTeams       TeamInvite[]             @relation("TeamInviteInviter")
}

model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AdminEmailOtpChallenge {
  id         String               @id @default(cuid())
  userId     String
  purpose    AdminEmailOtpPurpose
  tokenHash  String               @unique
  codeHash   String
  attempts   Int                  @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime             @default(now())
  user       AdminUser            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  Membership[]
  applications Application[]
  auditEvents  AuditEvent[]
  teamInvites  TeamInvite[]
  resellers    Reseller[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(ANALYST)
  createdAt      DateTime       @default(now())
  user           AdminUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Application {
  id                    String                 @id @default(cuid())
  organizationId        String
  name                  String
  slug                  String
  publicId              String                 @unique
  status                AppStatus              @default(ACTIVE)
  version               String                 @default("1.0.0")
  downloadUrl           String?
  signingKeyId          String
  signingPublicKey      String
  signingPrivateKey     String
  maxDevicesDefault     Int                    @default(1)
  sessionMinutes        Int                    @default(60)
  heartbeatSeconds      Int                    @default(60)
  allowUserRegistration Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plans                 Plan[]
  licenses              License[]
  users                 EndUser[]
  clientSessions        ClientSession[]
  apiKeys               ApiKey[]
  webhooks              WebhookEndpoint[]
  auditEvents           AuditEvent[]
  variables             ApplicationVariable[]
  builds                BuildArtifact[]
  managedFiles          ManagedFile[]
  accessRules           AccessRule[]
  remoteFunctions       RemoteFunction[]
  chatChannels          ChatChannel[]
  loginTokens           ProductLoginToken[]
  notificationChannels  NotificationChannel[]
  compatibilitySessions CompatibilitySession[]
  resellers             Reseller[]
  compatEnabled         Boolean                @default(false)
  compatName            String?
  compatOwnerId         String?
  compatSecretHash      String?

  @@unique([organizationId, slug])
  @@unique([organizationId, compatName])
  @@unique([compatOwnerId, compatName])
  @@index([organizationId, status])
}

model Plan {
  id              String             @id @default(cuid())
  applicationId   String
  name            String
  description     String?
  durationDays    Int?
  entitlements    Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  application     Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  licenses        License[]
  users           EndUser[]
  subscriptions   UserSubscription[]
  managedFiles    ManagedFile[]
  remoteFunctions RemoteFunction[]

  @@unique([applicationId, name])
  @@index([applicationId])
}

model License {
  id            String             @id @default(cuid())
  applicationId String
  planId        String
  keyHash       String             @unique
  keyPrefix     String
  keyLastFour   String
  status        LicenseStatus      @default(UNUSED)
  durationDays  Int?
  expiresAt     DateTime?
  activatedAt   DateTime?
  maxDevices    Int                @default(1)
  customerEmail String?
  note          String?
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan          Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  activations   Activation[]
  sessions      ClientSession[]
  user          EndUser?
  subscriptions UserSubscription[]

  @@index([applicationId, status])
  @@index([planId])
  @@index([customerEmail])
}

model Activation {
  id                    String          @id @default(cuid())
  licenseId             String
  installationIdHash    String
  installationLabel     String?
  installationPublicKey String?
  firstIp               String?
  lastIp                String?
  createdAt             DateTime        @default(now())
  lastSeenAt            DateTime        @default(now())
  revokedAt             DateTime?
  license               License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  sessions              ClientSession[]

  @@unique([licenseId, installationIdHash])
  @@index([licenseId, revokedAt])
}

model EndUser {
  id             String                 @id @default(cuid())
  applicationId  String
  planId         String
  licenseId      String?                @unique
  username       String
  email          String?
  passwordHash   String
  status         EndUserStatus          @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lastLoginAt    DateTime?
  totpSecret     String?
  totpEnabled    Boolean                @default(false)
  application    Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan           Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  license        License?               @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  sessions       ClientSession[]
  subscriptions  UserSubscription[]
  variables      UserVariable[]
  passkeys       EndUserPasskey[]
  authChallenges ProductAuthChallenge[]
  loginTokens    ProductLoginToken[]
  chatMessages   ChatMessage[]

  @@unique([applicationId, username])
  @@unique([applicationId, email])
  @@index([applicationId, status])
}

model ClientSession {
  id            String      @id @default(cuid())
  applicationId String
  licenseId     String
  activationId  String
  userId        String?
  tokenHash     String      @unique
  createdAt     DateTime    @default(now())
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  license       License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  activation    Activation  @relation(fields: [activationId], references: [id], onDelete: Cascade)
  user          EndUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  compatibilitySession CompatibilitySession?

  @@index([applicationId, expiresAt])
  @@index([licenseId, revokedAt])
  @@index([activationId])
}

model ApiKey {
  id            String      @id @default(cuid())
  applicationId String
  name          String
  prefix        String
  keyHash       String      @unique
  scopes        String[]    @default(["licenses:read", "licenses:write", "users:read", "users:write", "webhooks:write", "features:read", "features:write", "files:write"])
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, revokedAt])
}

model WebhookEndpoint {
  id            String            @id @default(cuid())
  applicationId String
  url           String
  description   String?
  secret        String
  events        String[]
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@index([applicationId, active])
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String
  eventType     String
  eventId       String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  responseBody  String?
  nextAttemptAt DateTime?
  createdAt     DateTime              @default(now())
  deliveredAt   DateTime?
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  applicationId  String?
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor          AdminUser?   @relation("ActorAuditEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuthAttempt {
  id        String   @id @default(cuid())
  bucket    String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
  @@index([createdAt])
}

model TeamInvite {
  id              String         @id @default(cuid())
  organizationId  String
  invitedByUserId String
  email           String
  role            MembershipRole
  tokenHash       String         @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       AdminUser      @relation("TeamInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([expiresAt])
}

model UserSubscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  licenseId String?
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      EndUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  license   License?           @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([planId, status])
  @@index([expiresAt])
}

model ApplicationVariable {
  id            String             @id @default(cuid())
  applicationId String
  key           String
  value         String
  visibility    VariableVisibility @default(AUTHENTICATED)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@index([applicationId, visibility, active])
}

model UserVariable {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      EndUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model BuildArtifact {
  id            String      @id @default(cuid())
  applicationId String
  version       String
  platform      String
  sha256        String
  downloadUrl   String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version, platform])
  @@index([applicationId, active])
}

model ManagedFile {
  id            String      @id @default(cuid())
  applicationId String
  planId        String?
  name          String
  storageKey    String      @unique
  originalName  String
  contentType   String
  size          Int
  sha256        String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan          Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([applicationId, name])
  @@index([applicationId, active])
  @@index([planId])
}

model AccessRule {
  id            String            @id @default(cuid())
  applicationId String
  effect        AccessRuleEffect
  subject       AccessRuleSubject
  valueHash     String
  valuePreview  String
  reason        String?
  active        Boolean           @default(true)
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, effect, subject, valueHash])
  @@index([applicationId, active, expiresAt])
}

model RemoteFunction {
  id                 String      @id @default(cuid())
  applicationId      String
  requiredPlanId     String?
  name               String
  response           Json        @default("{}")
  active             Boolean     @default(true)
  rateLimitPerMinute Int         @default(60)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requiredPlan       Plan?       @relation(fields: [requiredPlanId], references: [id], onDelete: SetNull)

  @@unique([applicationId, name])
  @@index([applicationId, active])
}

model ChatChannel {
  id            String        @id @default(cuid())
  applicationId String
  name          String
  delaySeconds  Int           @default(3)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@unique([applicationId, name])
  @@index([applicationId, active])
}

model ChatMessage {
  id         String      @id @default(cuid())
  channelId  String
  userId     String?
  authorType String
  authorName String
  body       String
  createdAt  DateTime    @default(now())
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       EndUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
  @@index([userId, createdAt])
}

model EndUserPasskey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         EndUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductAuthChallenge {
  id        String        @id @default(cuid())
  userId    String
  kind      ChallengeKind
  challenge String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      EndUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
  @@index([expiresAt])
}

model ProductLoginToken {
  id            String      @id @default(cuid())
  applicationId String
  userId        String
  tokenHash     String      @unique
  purpose       String      @default("web_loader")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          EndUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, expiresAt])
  @@index([userId, expiresAt])
}

model NotificationChannel {
  id            String                  @id @default(cuid())
  applicationId String
  kind          NotificationChannelKind
  name          String
  endpoint      String
  secret        String?
  events        String[]
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  application   Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name])
  @@index([applicationId, active])
}

model Reseller {
  id             String       @id @default(cuid())
  organizationId String
  applicationId  String?
  name           String
  prefix         String
  keyHash        String       @unique
  scopes         String[]     @default(["licenses:read", "licenses:write", "users:read"])
  credits        Int          @default(0)
  active         Boolean      @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@index([applicationId, active])
}

model CompatibilitySession {
  id            String      @id @default(cuid())
  applicationId String
  clientSessionId String?    @unique
  tokenHash     String      @unique
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clientSession ClientSession? @relation(fields: [clientSessionId], references: [id], onDelete: SetNull)

  @@index([applicationId, expiresAt])
  @@index([expiresAt])
}
