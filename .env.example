DATABASE_URL="postgresql://keyforge:keyforge@localhost:5432/keyforge?schema=public"
KEYFORGE_MASTER_KEY="replace-with-32-random-bytes-encoded-as-base64"
KEYFORGE_BASE_URL="http://localhost:3000"
KEYFORGE_DOMAIN="keyforge.example.com"
KEYFORGE_LEGACY_DOMAIN="auth.example.com"
KEYFORGE_SESSION_DAYS="7"
KEYFORGE_DEMO_MODE="false"
KEYFORGE_STORAGE_DIR="./data/files"
KEYFORGE_MAX_UPLOAD_MB="50"
KEYFORGE_RP_ID="localhost"
KEYFORGE_RP_NAME="Keyforge"
KEYFORGE_RP_ORIGIN="http://localhost:3000"

# Optional admin email OTP delivery. Gmail requires 2-Step Verification and an App Password.
KEYFORGE_SMTP_HOST="smtp.gmail.com"
KEYFORGE_SMTP_PORT="465"
KEYFORGE_SMTP_SECURE="true"
KEYFORGE_SMTP_USER="you@gmail.com"
KEYFORGE_SMTP_PASSWORD="replace-with-a-google-app-password"
KEYFORGE_SMTP_FROM="Keyforge <you@gmail.com>"
