{
  "name": "keyforge",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "Self-hosted software licensing and authentication platform",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "key:generate": "tsx scripts/generate-master-key.ts",
    "key:rotate": "node --env-file=.env --import tsx scripts/rotate-master-key.ts --confirm",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-windows-local.ps1",
    "sdk:build": "tsc -p sdk/typescript/tsconfig.json",
    "sdk:check": "pnpm sdk:build && python -m compileall -q sdk/python/keyforge",
    "check": "pnpm lint && pnpm test && pnpm build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/client": "6.19.0",
    "@radix-ui/themes": "3.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "jose": "6.2.8",
    "next": "16.3.0",
    "nodemailer": "7.0.11",
    "otpauth": "9.5.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "16.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
